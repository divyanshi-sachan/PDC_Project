# Copy to .env. `neon deploy` / `neon env pull` fill in the Neon block automatically.
# In prod: server-side .env on EC2 (chmod 600) / SSM, and Vercel env vars.

# --- SEC (required) — descriptive User-Agent with contact info
SEC_USER_AGENT="DealPilot your-email@example.com"

# --- Neon (written by `neon deploy` / `neon env pull`) -------------------------
# Postgres: pooled for app traffic, direct (unpooled) for migrations.
DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=
NEON_BRANCH_ID=
# Managed Better Auth
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Object Storage (S3-compatible; bucket "assets" declared in neon.ts)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
NEON_FUNCTION_HOST_SUFFIX=

# --- Auth app secret (NOT provided by Neon) — `openssl rand -base64 32`
NEON_AUTH_COOKIE_SECRET=

# --- Internal services (Docker network names on EC2)
EDGAR_SERVICE_URL=http://localhost:8100
EDGAR_SERVICE_KEY=dev-change-me
LITELLM_BASE_URL=http://localhost:4001
LITELLM_MASTER_KEY=sk-dev-change-me

# --- LLM providers (read by LiteLLM only; app code never uses these directly)
ANTHROPIC_API_KEY=          # Sonnet 5.5 verifier/skeptic/writer, Haiku 5.5 fallback
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Web research
TAVILY_API_KEY=
EXA_API_KEY=

# --- Market data (free tiers, cached in Postgres)
FMP_API_KEY=
TIINGO_API_KEY=
FRED_API_KEY=

# --- Observability (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Budget guardrails
MAX_COST_PER_TASK_USD=0.50
