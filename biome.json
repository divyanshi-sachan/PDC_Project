{
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/*.gen.ts",
      "!services",
      "!data",
      "!docs",
      "!packages/db/migrations",
      "!**/*.md",
      "!.claude/hooks"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noNonNullAssertion": "warn"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
